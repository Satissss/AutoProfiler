{
  "config": {
    "name": "autoprofiler",
    "benchmark": "kernelbench",
    "groups": [
      "level1",
      "level2",
      "level3"
    ],
    "ids": null,
    "limit": 3,
    "methods": {
      "autoprofiler": {
        "seeder": {
          "type": "llm_port",
          "language": "triton",
          "attempts": 4
        },
        "profiler": {
          "type": "tree",
          "path": "output/trees/autoprofiler.json"
        },
        "optimizer": {
          "type": "leaf",
          "strong": true,
          "n_samples": 2,
          "max_repair": 2
        }
      }
    },
    "llm": {
      "model": "qwen-plus",
      "base_url": "https://dashscope.aliyuncs.com/compatible-mode/v1",
      "api_key_env": "QWEN_API_KEY"
    },
    "backend": "configs/backends/k8s.yaml",
    "rounds": 2,
    "fast": [
      3,
      10
    ],
    "final": [
      10,
      100
    ],
    "output": "output/results"
  },
  "tasks": [
    {
      "id": "kb_l1_1",
      "group": "level1"
    },
    {
      "id": "kb_l1_2",
      "group": "level1"
    },
    {
      "id": "kb_l1_3",
      "group": "level1"
    }
  ]
}