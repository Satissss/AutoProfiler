# Copy to .env and fill in the secret key. .env is git-ignored; NEVER commit it.
#
# Only the SECRET api key belongs here. The provider id, model, and base_url are
# non-secret and live in config/npt.yaml (llm: section). The key env var name is
# derived from `llm.provider`: provider=qwen -> QWEN_API_KEY.

# --- Active provider (matches config/npt.yaml `llm.provider: qwen`) ---
QWEN_API_KEY=sk-your-dashscope-key-here

# --- Other providers (uncomment the one matching llm.provider) ---
# OPENAI_API_KEY=sk-your-openai-key-here
# DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# --- Generic fallback (used if no <PROVIDER>_API_KEY is set) ---
# AUTOPROFILER_LLM_API_KEY=sk-...
